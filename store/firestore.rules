rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isShopAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ssselimilhan@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Admin-only app configuration (including one-time catalog initialization marker).
    match /app_config/{configId} {
      allow read, write: if isShopAdmin();
    }

    // Theme catalog: players can only read published items; only the verified owner can manage it.
    match /cosmetic_catalog/{itemId} {
      allow read: if isShopAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isShopAdmin();
    }

    // Account-owned cloud progress; each user can access only their own data.
    match /users/{userId}/private/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /rooms/{roomCode} {
      allow read: if true;
      allow create: if request.resource.data.roomStatus == 'waiting'
                    && request.resource.data.hostDeviceId is string;
      allow update: if request.resource.data.hostDeviceId == resource.data.hostDeviceId
        && (!('tournamentMatchId' in resource.data)
          || request.resource.data.guestDeviceId == resource.data.guestDeviceId
          || (request.resource.data.guestDeviceId == resource.data.inviteToDeviceId
            && request.auth != null
            && get(/databases/$(database)/documents/channels/$(resource.data.tournamentChannelId)/tournaments/$(resource.data.tournamentId)/matches/$(resource.data.tournamentMatchId)).data.player2Uid == request.auth.uid)
          || request.resource.data.guestDeviceId == null);
      allow delete: if false;


      match /room_messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() < 300
                      && request.resource.data.expiresAt is timestamp;
        allow update: if false;
        allow delete: if true;
      }

      // Backward compatibility for already-installed clients; new builds use
      // room_messages so their chat history can receive an independent TTL.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() < 300;
        allow update: if false;
        allow delete: if true;
      }
    }

    function channelMemberPath(channelId, uid) {
      return /databases/$(database)/documents/channels/$(channelId)/members/$(uid);
    }

    function isChannelMember(channelId) {
      return request.auth != null
        && exists(channelMemberPath(channelId, request.auth.uid));
    }

    function isChannelOwner(channelId) {
      return request.auth != null
        && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerDeviceId == request.auth.uid;
    }

    function channelJoinRequestPath(channelId, uid) {
      return /databases/$(database)/documents/channels/$(channelId)/join_requests/$(uid);
    }

    function channelInvitePath(code) {
      return /databases/$(database)/documents/channel_invites/$(code);
    }

    match /channels/{channelId} {
      // Public channels are discoverable; private channel documents are visible
      // only to authenticated members. Rules are not query filters.
      allow get: if request.auth != null;
      // Both public and invite-only channels are discoverable. Invite secrets
      // are stored in a private subdocument, never in the listed channel doc.
      allow list: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerDeviceId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 32
        && request.resource.data.visibility in ['public', 'invite_only']
        && existsAfter(channelMemberPath(channelId, request.auth.uid))
        && getAfter(channelMemberPath(channelId, request.auth.uid)).data.role == 'owner';

      allow update: if request.auth != null && (
        // Owner may edit channel presentation only; lifecycle changes use
        // the permanent deletion flow instead of archive/reopen states.
        (resource.data.ownerDeviceId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'description', 'ownerDisplayName', 'updatedAt']))
        ||
        // New member joins: their membership is created in the same batch.
        (existsAfter(channelMemberPath(channelId, request.auth.uid))
          && !exists(channelMemberPath(channelId, request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          && resource.data.status == 'open'
          && resource.data.visibility in ['public', 'invite_only']
          && request.resource.data.memberCount == resource.data.memberCount + 1)
        ||
        // The owner approves a pending invite-only join request in one transaction.
        (resource.data.ownerDeviceId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'lastApprovedUid', 'updatedAt'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.lastApprovedUid is string
          && existsAfter(channelMemberPath(channelId, request.resource.data.lastApprovedUid))
          && !exists(channelMemberPath(channelId, request.resource.data.lastApprovedUid))
          && exists(channelJoinRequestPath(channelId, request.resource.data.lastApprovedUid))
          && existsAfter(channelJoinRequestPath(channelId, request.resource.data.lastApprovedUid))
          && get(channelJoinRequestPath(channelId, request.resource.data.lastApprovedUid)).data.status == 'pending'
          && getAfter(channelJoinRequestPath(channelId, request.resource.data.lastApprovedUid)).data.status == 'accepted')
        ||
        // Member leaves: their membership is deleted in the same transaction.
        (exists(channelMemberPath(channelId, request.auth.uid))
          && !existsAfter(channelMemberPath(channelId, request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'updatedAt', 'ownerDeviceId', 'ownerDisplayName', 'status'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && (
            // A regular member cannot alter channel ownership.
            (resource.data.ownerDeviceId != request.auth.uid
              && request.resource.data.ownerDeviceId == resource.data.ownerDeviceId
              && request.resource.data.ownerDisplayName == resource.data.ownerDisplayName
              && request.resource.data.status == resource.data.status)
            ||
            // The owner may transfer ownership to a remaining member, or close an empty channel.
            (resource.data.ownerDeviceId == request.auth.uid
              && (request.resource.data.ownerDeviceId == null
                  || (request.resource.data.ownerDeviceId == request.auth.uid && request.resource.data.status == 'closed')
                  || (existsAfter(channelMemberPath(channelId, request.resource.data.ownerDeviceId))
                      && getAfter(channelMemberPath(channelId, request.resource.data.ownerDeviceId)).data.role == 'owner')))
          ))
      );

      allow delete: if request.auth != null && resource.data.ownerDeviceId == request.auth.uid;

      match /private/{secretId} {
        allow get: if request.auth != null && secretId == 'invite' && isChannelMember(channelId);
        allow list: if false;
        allow create, update: if request.auth != null
          && secretId == 'invite'
          && getAfter(/databases/$(database)/documents/channels/$(channelId)).data.ownerDeviceId == request.auth.uid
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$');
        allow delete: if isChannelOwner(channelId);
      }

      match /join_requests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isChannelOwner(channelId));
        allow list: if isChannelOwner(channelId);
        allow create: if request.auth != null
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/channels/$(channelId)).data.visibility == 'invite_only'
          && get(/databases/$(database)/documents/channels/$(channelId)).data.status == 'open'
          && !exists(channelMemberPath(channelId, uid))
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 32
          && request.resource.data.playerDeviceId is string
          && request.resource.data.playerDeviceId.size() <= 128
          && request.resource.data.status == 'pending';
        allow delete: if isChannelOwner(channelId);
        allow update: if isChannelOwner(channelId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.respondedAt == request.time;
      }

      match /members/{uid} {
        allow get: if request.auth != null
          && (uid == request.auth.uid || isChannelMember(channelId));
        allow list: if isChannelMember(channelId);

        allow create: if request.auth != null && (
          // A player joins a public channel or uses a valid invite code.
          (uid == request.auth.uid
            && request.resource.data.deviceId == request.auth.uid
            && (
              (existsAfter(/databases/$(database)/documents/channels/$(channelId))
                && getAfter(/databases/$(database)/documents/channels/$(channelId)).data.ownerDeviceId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/channels/$(channelId)).data.visibility == 'public'
                && get(/databases/$(database)/documents/channels/$(channelId)).data.status == 'open')
              ||
              (request.resource.data.inviteCode is string
                && exists(channelInvitePath(request.resource.data.inviteCode))
                && get(channelInvitePath(request.resource.data.inviteCode)).data.channelId == channelId
                && get(/databases/$(database)/documents/channels/$(channelId)).data.visibility == 'invite_only'
                && get(/databases/$(database)/documents/channels/$(channelId)).data.status == 'open')
            ))
          ||
          // Channel owner creates the member record only while consuming that user's pending request.
          (isChannelOwner(channelId)
            && request.resource.data.deviceId == uid
            && exists(channelJoinRequestPath(channelId, uid))
            && existsAfter(channelJoinRequestPath(channelId, uid))
            && get(channelJoinRequestPath(channelId, uid)).data.status == 'pending'
            && getAfter(channelJoinRequestPath(channelId, uid)).data.status == 'accepted')
        );

        allow update: if (
          request.auth != null
          && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['playerDeviceId', 'displayName', 'identityUpdatedAt'])
          && request.resource.data.playerDeviceId is string
          && request.resource.data.playerDeviceId.size() > 0
          && request.resource.data.playerDeviceId.size() <= 128
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 32
        ) || (
          isChannelOwner(channelId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        );
        allow delete: if request.auth != null && (uid == request.auth.uid || isChannelOwner(channelId));
      }
      match /messages/{messageId} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelMember(channelId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 32
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.isAnnouncement is bool
          && request.resource.data.sentAt == request.time
          && (!request.resource.data.isAnnouncement || isChannelOwner(channelId));
        allow update: if false;
        allow delete: if isChannelOwner(channelId);
      }

      // Channel-wide competitive statistics. Each tournament can be
      // counted only once per player and values must match its final podium.
      match /tournament_stats/{uid} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelOwner(channelId)
          && request.resource.data.uid == uid
          && request.resource.data.tournamentIds is list
          && request.resource.data.tournamentIds.size() == 1
          && request.resource.data.tournamentsPlayed == 1
          && request.resource.data.championships == (request.resource.data.lastRank == 1 ? 1 : 0)
          && request.resource.data.secondPlaces == (request.resource.data.lastRank == 2 ? 1 : 0)
          && request.resource.data.thirdPlaces == (request.resource.data.lastRank == 3 ? 1 : 0)
          && request.resource.data.podiums == (request.resource.data.lastRank in [1, 2, 3] ? 1 : 0)
          && request.resource.data.starsEarned == request.resource.data.lastStars
          && request.resource.data.lastTournamentId is string
          && getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.status == 'completed'
          && getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.creatorDeviceId == request.auth.uid
          && request.resource.data.lastRank == (uid in getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements ? getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements[uid].rank : 0)
          && request.resource.data.lastStars == (uid in getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements ? getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements[uid].stars : 0);
        allow update: if isChannelOwner(channelId)
          && request.resource.data.uid == uid
          && request.resource.data.tournamentIds is list
          && request.resource.data.tournamentIds.size() == resource.data.tournamentIds.size() + 1
          && request.resource.data.tournamentIds.hasAll(resource.data.tournamentIds)
          && request.resource.data.tournamentsPlayed == resource.data.tournamentsPlayed + 1
          && request.resource.data.championships == resource.data.championships + (request.resource.data.lastRank == 1 ? 1 : 0)
          && request.resource.data.secondPlaces == resource.data.secondPlaces + (request.resource.data.lastRank == 2 ? 1 : 0)
          && request.resource.data.thirdPlaces == resource.data.thirdPlaces + (request.resource.data.lastRank == 3 ? 1 : 0)
          && request.resource.data.podiums == resource.data.podiums + (request.resource.data.lastRank in [1, 2, 3] ? 1 : 0)
          && request.resource.data.starsEarned == resource.data.starsEarned + request.resource.data.lastStars
          && !(request.resource.data.lastTournamentId in resource.data.tournamentIds)
          && getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.status == 'completed'
          && getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.creatorDeviceId == request.auth.uid
          && request.resource.data.lastRank == (uid in getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements ? getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements[uid].rank : 0)
          && request.resource.data.lastStars == (uid in getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements ? getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(request.resource.data.lastTournamentId)).data.placements[uid].stars : 0);
        allow delete: if isChannelOwner(channelId);
      }


      match /tournaments/{tournamentId} {
        allow read: if isChannelMember(channelId) || (request.auth != null
          && resource.data.status == 'completed'
          && resource.data.placements is map
          && request.auth.uid in resource.data.placements.keys());
        allow create: if isChannelOwner(channelId)
          && request.resource.data.creatorDeviceId == request.auth.uid
          && request.resource.data.status == 'registration'
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 40
          && request.resource.data.format in ['single_elimination', 'round_robin']
          && request.resource.data.maxPlayers in [8, 16, 32, 64]
          && (request.resource.data.format != 'round_robin' || request.resource.data.maxPlayers <= 16)
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() == 0;
        allow update: if request.auth != null && (
          // Only the channel owner may start a tournament.
          (isChannelOwner(channelId)
            && resource.data.creatorDeviceId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'startedAt', 'currentRound', 'matchCount', 'winnerUid', 'completedAt', 'tiedWinnerUids', 'placements'])
            && request.resource.data.status in ['in_progress', 'completed'])
          ||
          // A channel member may add only their own UID while registration is open.
          (isChannelMember(channelId)
            && resource.data.status == 'registration'
            && request.resource.data.status == 'registration'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
            && request.resource.data.participantIds is list
            && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
            && request.resource.data.participantIds.size() <= resource.data.maxPlayers
            && request.resource.data.participantIds.hasAll(resource.data.participantIds)
            && request.auth.uid in request.resource.data.participantIds
            && !(request.auth.uid in resource.data.participantIds))
        );
        allow delete: if isChannelOwner(channelId);

        match /reward_claims/{uid} {
          allow read: if request.auth != null
            && (request.auth.uid == uid || isChannelOwner(channelId));
          allow create: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.uid == uid
            && get(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.status == 'completed'
            && get(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.placements[uid].rank == request.resource.data.rank
            && get(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.placements[uid].stars == request.resource.data.stars
            && request.resource.data.rank in [1, 2, 3]
            && request.resource.data.stars is int
            && request.resource.data.stars > 0
            && request.resource.data.claimedAt == request.time;
          allow update: if false;
          allow delete: if isChannelOwner(channelId);
        }

        match /matches/{matchId} {
          allow read: if isChannelMember(channelId);
          allow create: if isChannelOwner(channelId)
            && getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.status == 'in_progress'
            && request.resource.data.round is int
            && request.resource.data.matchIndex is int
            && request.resource.data.player1Uid is string
            && (request.resource.data.player2Uid == null || request.resource.data.player2Uid is string)
            && request.resource.data.status in ['ready', 'completed']
            && (
              (request.resource.data.status == 'ready' && request.resource.data.winnerUid == null)
              ||
              (request.resource.data.status == 'completed'
                && request.resource.data.isBye == true
                && request.resource.data.winnerUid == request.resource.data.player1Uid)
            );
          allow update: if (
            // A match participant may attach exactly one room, and only as player 1.
            (request.auth != null
              && request.auth.uid == resource.data.player1Uid
              && resource.data.status == 'ready'
              && request.resource.data.status == 'ready'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['roomCode', 'roomCreatedBy', 'roomLinkedAt'])
              && request.resource.data.roomCreatedBy == request.auth.uid
              && request.resource.data.roomCode is string
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.hostDeviceId == request.auth.uid
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.inviteToDeviceId == get(/databases/$(database)/documents/channels/$(channelId)/members/$(resource.data.player2Uid)).data.playerDeviceId
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.tournamentChannelId == channelId
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.tournamentId == tournamentId
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.tournamentMatchId == matchId)
            ||
            // Player 1 may clear the link only after that exact room was cancelled.
            (request.auth != null
              && request.auth.uid == resource.data.player1Uid
              && resource.data.status == 'ready'
              && request.resource.data.status == 'ready'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['roomCode', 'roomCreatedBy', 'roomLinkedAt'])
              && !('roomCode' in request.resource.data)
              && !('roomCreatedBy' in request.resource.data)
              && !('roomLinkedAt' in request.resource.data)
              && resource.data.roomCode is string
              && (!exists(/databases/$(database)/documents/rooms/$(resource.data.roomCode))
                || (get(/databases/$(database)/documents/rooms/$(resource.data.roomCode)).data.roomStatus == 'cancelled'
                  && get(/databases/$(database)/documents/rooms/$(resource.data.roomCode)).data.tournamentChannelId == channelId
                  && get(/databases/$(database)/documents/rooms/$(resource.data.roomCode)).data.tournamentId == tournamentId
                  && get(/databases/$(database)/documents/rooms/$(resource.data.roomCode)).data.tournamentMatchId == matchId)))
            ||
            // The channel owner remains the only person allowed to confirm a result and advance the bracket.
            (isChannelOwner(channelId)
              && resource.data.status == 'ready'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['winnerUid', 'status', 'resultAt'])
              && request.resource.data.status == 'completed'
              && request.resource.data.winnerUid in
                [resource.data.player1Uid, resource.data.player2Uid])
          );
          allow delete: if isChannelOwner(channelId);
        }
      }
    }

    // Invite-code documents are intentionally get-only: a user must know the
    // high-entropy code to resolve a private channel; enumeration is forbidden.
    match /channel_invites/{inviteCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerDeviceId == request.auth.uid
        && getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.visibility == 'invite_only'
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerDeviceId == request.auth.uid;
    }

    // Globally unique account nicknames. Clients may only reserve or release
    // their own UID's name; reads are point lookups so names cannot be enumerated.
    match /nicknames/{nicknameKey} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 20;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 20;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /profiles/{deviceId} {
      allow read: if true;
      allow write: if request.resource.data.displayName is string
                   && request.resource.data.displayName.size() < 40;
      allow delete: if true;
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if request.resource.data.toDeviceId is string
                    && request.resource.data.fromDeviceId is string;
      allow update: if false;
      allow delete: if true;
    }

    match /game_results/{resultId} {
      allow read: if true;
      allow create: if request.resource.data.deviceId is string;
      allow update: if false;
      allow delete: if false;
    }

    // Arkadaşlık istekleri ve arkadaşlıklar
    match /friend_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.fromDeviceId is string
                    && request.resource.data.toDeviceId is string;
      allow update: if false;
      allow delete: if true;
    }

    match /friendships/{pairId} {
      allow read: if true;
      allow create: if request.resource.data.users is list
                    && request.resource.data.users.size() == 2;
      allow update: if false;
      allow delete: if true;
    }

    // Anonim kullanım olayları ve hata kayıtları: sadece yazılır, uygulamadan okunamaz
    match /app_events/{eventId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() < 40;
      allow read, update, delete: if false;
    }

    match /app_errors/{errorId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 600;
      allow read, update, delete: if false;
    }

    // Geri bildirimler (öneri/şikayet/hata): sadece yazılır, uygulamadan okunamaz
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 600;
      allow read, update, delete: if false;
    }

    // Şikayetler: herkes gönderebilir, uygulamadan kimse okuyamaz
    // (sadece sen, Firebase Console'dan görürsün).
    match /reports/{reportId} {
      allow create: if request.resource.data.reporterDeviceId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() < 100;
      allow read, update, delete: if false;
    }
  }
}
