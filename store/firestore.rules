rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isShopAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ssselimilhan@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Admin-only app configuration (including one-time catalog initialization marker).
    match /app_config/{configId} {
      allow read, write: if isShopAdmin();
    }

    // Theme catalog: players can only read published items; only the verified owner can manage it.
    match /cosmetic_catalog/{itemId} {
      allow read: if isShopAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isShopAdmin();
    }

    // Account-owned cloud progress; each user can access only their own data.
    match /users/{userId}/private/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /rooms/{roomCode} {
      allow read: if true;
      allow create: if request.resource.data.roomStatus == 'waiting'
                    && request.resource.data.hostDeviceId is string;
      allow update: if request.resource.data.hostDeviceId == resource.data.hostDeviceId;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() < 300;
        allow update: if false;
        allow delete: if true;
      }
    }

    match /channels/{channelId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.name.size() <= 32
                    && request.resource.data.ownerDeviceId is string;
      allow update: if request.resource.data.ownerDeviceId == null
                    || request.resource.data.ownerDeviceId == resource.data.ownerDeviceId
                    || (request.resource.data.ownerDeviceId is string
                        && exists(/databases/$(database)/documents/channels/$(channelId)/members/$(request.resource.data.ownerDeviceId)));
      allow delete: if false;
      match /members/{deviceId} {
        allow read: if true;
        allow create: if request.resource.data.deviceId == deviceId;
        allow delete: if resource.data.deviceId == deviceId;
        allow update: if false;
      }
    }

    match /profiles/{deviceId} {
      allow read: if true;
      allow write: if request.resource.data.displayName is string
                   && request.resource.data.displayName.size() < 40;
      allow delete: if true;
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if request.resource.data.toDeviceId is string
                    && request.resource.data.fromDeviceId is string;
      allow update: if false;
      allow delete: if true;
    }

    match /game_results/{resultId} {
      allow read: if true;
      allow create: if request.resource.data.deviceId is string;
      allow update: if false;
      allow delete: if false;
    }

    // Arkadaşlık istekleri ve arkadaşlıklar
    match /friend_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.fromDeviceId is string
                    && request.resource.data.toDeviceId is string;
      allow update: if false;
      allow delete: if true;
    }

    match /friendships/{pairId} {
      allow read: if true;
      allow create: if request.resource.data.users is list
                    && request.resource.data.users.size() == 2;
      allow update: if false;
      allow delete: if true;
    }

    // Anonim kullanım olayları ve hata kayıtları: sadece yazılır, uygulamadan okunamaz
    match /app_events/{eventId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() < 40;
      allow read, update, delete: if false;
    }

    match /app_errors/{errorId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 600;
      allow read, update, delete: if false;
    }

    // Geri bildirimler (öneri/şikayet/hata): sadece yazılır, uygulamadan okunamaz
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 600;
      allow read, update, delete: if false;
    }

    // Şikayetler: herkes gönderebilir, uygulamadan kimse okuyamaz
    // (sadece sen, Firebase Console'dan görürsün).
    match /reports/{reportId} {
      allow create: if request.resource.data.reporterDeviceId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() < 100;
      allow read, update, delete: if false;
    }
  }
}
