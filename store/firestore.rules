rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isShopAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ssselimilhan@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Admin-only app configuration (including one-time catalog initialization marker).
    match /app_config/{configId} {
      allow read, write: if isShopAdmin();
    }

    // Theme catalog: players can only read published items; only the verified owner can manage it.
    match /cosmetic_catalog/{itemId} {
      allow read: if isShopAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isShopAdmin();
    }

    // Account-owned cloud progress; each user can access only their own data.
    match /users/{userId}/private/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /rooms/{roomCode} {
      allow read: if true;
      allow create: if request.resource.data.roomStatus == 'waiting'
                    && request.resource.data.hostDeviceId is string;
      allow update: if request.resource.data.hostDeviceId == resource.data.hostDeviceId;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() < 300;
        allow update: if false;
        allow delete: if true;
      }
    }

    function channelMemberPath(channelId, uid) {
      return /databases/$(database)/documents/channels/$(channelId)/members/$(uid);
    }

    function isChannelMember(channelId) {
      return request.auth != null
        && exists(channelMemberPath(channelId, request.auth.uid));
    }

    function isChannelOwner(channelId) {
      return request.auth != null
        && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerDeviceId == request.auth.uid;
    }

    function channelInvitePath(code) {
      return /databases/$(database)/documents/channel_invites/$(code);
    }

    match /channels/{channelId} {
      // Public channels are discoverable; private channel documents are visible
      // only to authenticated members. Rules are not query filters.
      allow get: if request.auth != null
        && (resource.data.visibility == 'public' || isChannelMember(channelId));
      allow list: if request.auth != null && resource.data.visibility == 'public';

      allow create: if request.auth != null
        && request.resource.data.ownerDeviceId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 32
        && request.resource.data.visibility in ['public', 'invite_only']
        && existsAfter(channelMemberPath(channelId, request.auth.uid))
        && getAfter(channelMemberPath(channelId, request.auth.uid)).data.role == 'owner';

      allow update: if request.auth != null && (
        // Owner edits channel metadata / manages the channel.
        (resource.data.ownerDeviceId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'description', 'status', 'ownerDisplayName', 'updatedAt']))
        ||
        // New member joins: their membership is created in the same batch.
        (existsAfter(channelMemberPath(channelId, request.auth.uid))
          && !exists(channelMemberPath(channelId, request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          && resource.data.status == 'open'
          && resource.data.visibility in ['public', 'invite_only']
          && request.resource.data.memberCount == resource.data.memberCount + 1)
        ||
        // Member leaves: their membership is deleted in the same transaction.
        (exists(channelMemberPath(channelId, request.auth.uid))
          && !existsAfter(channelMemberPath(channelId, request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'updatedAt', 'ownerDeviceId', 'ownerDisplayName', 'status'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && (
            // A regular member cannot alter channel ownership.
            (resource.data.ownerDeviceId != request.auth.uid
              && request.resource.data.ownerDeviceId == resource.data.ownerDeviceId
              && request.resource.data.ownerDisplayName == resource.data.ownerDisplayName
              && request.resource.data.status == resource.data.status)
            ||
            // The owner may transfer ownership to a remaining member, or close an empty channel.
            (resource.data.ownerDeviceId == request.auth.uid
              && (request.resource.data.ownerDeviceId == null
                  || (existsAfter(channelMemberPath(channelId, request.resource.data.ownerDeviceId))
                      && getAfter(channelMemberPath(channelId, request.resource.data.ownerDeviceId)).data.role == 'owner')))
          ))
      );

      allow delete: if false;

      match /members/{uid} {
        allow get: if request.auth != null
          && (uid == request.auth.uid || isChannelMember(channelId));
        allow list: if isChannelMember(channelId);

        allow create: if request.auth != null
          && uid == request.auth.uid
          && request.resource.data.deviceId == request.auth.uid
          && (
            // Initial owner membership in the channel creation batch.
            (existsAfter(/databases/$(database)/documents/channels/$(channelId))
              && getAfter(/databases/$(database)/documents/channels/$(channelId)).data.ownerDeviceId == request.auth.uid)
            ||
            // Public channel join.
            (get(/databases/$(database)/documents/channels/$(channelId)).data.visibility == 'public'
              && get(/databases/$(database)/documents/channels/$(channelId)).data.status == 'open')
            ||
            // Private channel join: the supplied code must resolve to this channel.
            (request.resource.data.inviteCode is string
              && exists(channelInvitePath(request.resource.data.inviteCode))
              && get(channelInvitePath(request.resource.data.inviteCode)).data.channelId == channelId
              && get(/databases/$(database)/documents/channels/$(channelId)).data.visibility == 'invite_only'
              && get(/databases/$(database)/documents/channels/$(channelId)).data.status == 'open')
          );

        allow update: if isChannelOwner(channelId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
        allow delete: if request.auth != null && uid == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelMember(channelId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 32
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.isAnnouncement is bool
          && request.resource.data.sentAt == request.time
          && (!request.resource.data.isAnnouncement || isChannelOwner(channelId));
        allow update, delete: if false;
      }

      match /tournaments/{tournamentId} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelOwner(channelId)
          && request.resource.data.creatorDeviceId == request.auth.uid
          && request.resource.data.status == 'registration'
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 40
          && request.resource.data.format in ['single_elimination', 'round_robin']
          && request.resource.data.maxPlayers in [8, 16, 32, 64]
          && (request.resource.data.format != 'round_robin' || request.resource.data.maxPlayers <= 16)
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() == 0;
        allow update: if request.auth != null && (
          // Only the channel owner may start a tournament.
          (isChannelOwner(channelId)
            && resource.data.creatorDeviceId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'startedAt', 'currentRound', 'matchCount', 'winnerUid', 'completedAt', 'tiedWinnerUids', 'placements'])
            && request.resource.data.status in ['in_progress', 'completed'])
          ||
          // A channel member may add only their own UID while registration is open.
          (isChannelMember(channelId)
            && resource.data.status == 'registration'
            && request.resource.data.status == 'registration'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
            && request.resource.data.participantIds is list
            && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
            && request.resource.data.participantIds.size() <= resource.data.maxPlayers
            && request.resource.data.participantIds.hasAll(resource.data.participantIds)
            && request.auth.uid in request.resource.data.participantIds
            && !(request.auth.uid in resource.data.participantIds))
        );
        allow delete: if false;

        match /reward_claims/{uid} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow create: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.uid == uid
            && get(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.status == 'completed'
            && get(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.placements[uid].rank == request.resource.data.rank
            && get(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.placements[uid].stars == request.resource.data.stars
            && request.resource.data.rank in [1, 2, 3]
            && request.resource.data.stars is int
            && request.resource.data.stars > 0
            && request.resource.data.claimedAt == request.time;
          allow update, delete: if false;
        }

        match /matches/{matchId} {
          allow read: if isChannelMember(channelId);
          allow create: if isChannelOwner(channelId)
            && getAfter(/databases/$(database)/documents/channels/$(channelId)/tournaments/$(tournamentId)).data.status == 'in_progress'
            && request.resource.data.round is int
            && request.resource.data.matchIndex is int
            && request.resource.data.player1Uid is string
            && (request.resource.data.player2Uid == null || request.resource.data.player2Uid is string)
            && request.resource.data.status in ['ready', 'completed']
            && (
              (request.resource.data.status == 'ready' && request.resource.data.winnerUid == null)
              ||
              (request.resource.data.status == 'completed'
                && request.resource.data.isBye == true
                && request.resource.data.winnerUid == request.resource.data.player1Uid)
            );
          allow update: if isChannelOwner(channelId)
            && resource.data.status == 'ready'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['winnerUid', 'status', 'resultAt'])
            && request.resource.data.status == 'completed'
            && request.resource.data.winnerUid in
              [resource.data.player1Uid, resource.data.player2Uid];
          allow delete: if false;
        }
      }
    }

    // Invite-code documents are intentionally get-only: a user must know the
    // high-entropy code to resolve a private channel; enumeration is forbidden.
    match /channel_invites/{inviteCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerDeviceId == request.auth.uid
        && getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.inviteCode == inviteCode;
      allow update: if false;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerDeviceId == request.auth.uid;
    }

    match /profiles/{deviceId} {
      allow read: if true;
      allow write: if request.resource.data.displayName is string
                   && request.resource.data.displayName.size() < 40;
      allow delete: if true;
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if request.resource.data.toDeviceId is string
                    && request.resource.data.fromDeviceId is string;
      allow update: if false;
      allow delete: if true;
    }

    match /game_results/{resultId} {
      allow read: if true;
      allow create: if request.resource.data.deviceId is string;
      allow update: if false;
      allow delete: if false;
    }

    // Arkadaşlık istekleri ve arkadaşlıklar
    match /friend_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.fromDeviceId is string
                    && request.resource.data.toDeviceId is string;
      allow update: if false;
      allow delete: if true;
    }

    match /friendships/{pairId} {
      allow read: if true;
      allow create: if request.resource.data.users is list
                    && request.resource.data.users.size() == 2;
      allow update: if false;
      allow delete: if true;
    }

    // Anonim kullanım olayları ve hata kayıtları: sadece yazılır, uygulamadan okunamaz
    match /app_events/{eventId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() < 40;
      allow read, update, delete: if false;
    }

    match /app_errors/{errorId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 600;
      allow read, update, delete: if false;
    }

    // Geri bildirimler (öneri/şikayet/hata): sadece yazılır, uygulamadan okunamaz
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 600;
      allow read, update, delete: if false;
    }

    // Şikayetler: herkes gönderebilir, uygulamadan kimse okuyamaz
    // (sadece sen, Firebase Console'dan görürsün).
    match /reports/{reportId} {
      allow create: if request.resource.data.reporterDeviceId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() < 100;
      allow read, update, delete: if false;
    }
  }
}
